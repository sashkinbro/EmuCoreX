<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only components. The RA host override lets test tooling point RetroAchievements at a
     test server; it must never ship exported in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <receiver
            android:name=".core.utils.RetroAchievementsHostOverrideReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.action.SET_RETROACHIEVEMENTS_HOST_OVERRIDE" />
                <action android:name="${applicationId}.action.CLEAR_RETROACHIEVEMENTS_HOST_OVERRIDE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
