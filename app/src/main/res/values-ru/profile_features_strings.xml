    <string name="profile_devices_title">Ваши устройства</string><string name="profile_devices_description">Для устройства используется случайный ID приложения, а не аппаратный идентификатор. Вы сами выбираете, показывать ли одно устройство в профиле.</string><string name="profile_devices_empty">Зарегистрированных устройств пока нет.</string><string name="profile_device_current">Это устройство</string><string name="profile_device_make_public">Показывать в профиле</string><string name="profile_device_make_private">Скрыть из профиля</string><string name="profile_device_show">Показать устройство</string>
